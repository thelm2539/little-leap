# Copy to .env and fill in from the Supabase dashboard.
# .env is gitignored — never commit real values.

# Safe to expose to the browser. These are shipped in the client bundle by
# design; RLS is what protects the data, not the secrecy of these keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side copies of the same values (used during SSR).
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# DANGER: bypasses row-level security entirely.
# Only ever read from src/integrations/supabase/client.server.ts, never from a
# route file or *.functions.ts — those ship to the client bundle. Set this in
# your host's secret store; do not put it in a local .env unless you need it.
# SUPABASE_SERVICE_ROLE_KEY=
